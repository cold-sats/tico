# GH_TOKEN, when an operator puts one in the runner's secrets/_shared.env, is the credential for git over https.
[credential "https://github.com"]
	helper = "!f() { [ -n \"$GH_TOKEN\" ] && { echo username=x-access-token; echo \"password=$GH_TOKEN\"; }; }; f"
[init]
	defaultBranch = main
# The workspace may belong to the supervisor while a turn (another user, same group) works in it.
[safe]
	directory = *
