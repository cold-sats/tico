# Copy to hq/.env (keep it private). See hq/compose.yaml and docs/telemetry.md.
# Any string of 16+ characters: the collector refuses to start without it, so it is only ever run on purpose.
TICO_HQ_KEY=
# Front door: cloudflared (an HQ-only tunnel, no open ports) or caddy (HTTPS on this host's ports 80 and 443).
COMPOSE_PROFILES=cloudflared
HQ_CLIENT_IP_HEADER=CF-Connecting-IP
# The public hostname, for either front door: the tunnel's route (cloudflared) or the certificate (caddy).
HQ_DOMAIN=hq.tico.team
# HQ_TUNNEL_TOKEN=
# With caddy, set HQ_CLIENT_IP_HEADER=X-Forwarded-For
# Optional backups: add ",backup" to COMPOSE_PROFILES
# HQ_BACKUP_URL=s3://my-bucket/tico-hq
# HQ_BACKUP_ENDPOINT=
# LITESTREAM_ACCESS_KEY_ID=
# LITESTREAM_SECRET_ACCESS_KEY=
