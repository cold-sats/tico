#!/usr/bin/env python3
"""`hub`: the company hub's CLI. See docs/history/hub-v2.md §5 and clients/hubcli.py.

Resolves the hub checkout from its own path, so the symlink in ~/.local/bin works from
anywhere and a second checkout uses its own clients/.
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from clients import hubcli  # noqa: E402

if __name__ == "__main__":
    sys.exit(hubcli.main(sys.argv[1:]))
