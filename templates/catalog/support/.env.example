# Names only. Values live in <projects>/secrets/<name>.env on the Mac that runs this bot, never in git.
# Only needed once an owner connects a source in bot.yaml `tools:`.
# The mail connector reads GOOGLE_SA_KEY as a file path on the machine, never into the run.
GOOGLE_SA_KEY=
SLACK_BOT_TOKEN=
# Tico HQ support tickets (docs/support.md). Only the project team's Support Agent sets these.
HQ_STAFF_KEY=
TICO_HQ_URL=
# GitHub issues and Discussions (playbooks/tico-github.md): read access only. Optional for issues, required for Discussions.
GITHUB_TOKEN=
GH_SUPPORT_REPOS=
